<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Connectivity (map tiles, future sync) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Offline Happy Paisa transfer rails -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- Required to be discoverable by other phones; without it Nearby can
         find others but nobody can find this device. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- Nearby Connections: BLE/Bluetooth discovery upgraded to Wi-Fi Direct -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Voice assistant -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Mr Happy, the embedded voice assistant -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- App profiles (IMD): toggle developer/debug/accessibility settings per app.
         WRITE_SECURE_SETTINGS is a signature permission the app CANNOT self-grant:
         grant once via ADB (`adb shell pm grant com.axzora.os android.permission.WRITE_SECURE_SETTINGS`)
         or Shizuku, exactly like SU_IMD. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Video calling -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Floating assistant bubble over other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Applying an atmosphere to the real lock/home wallpaper -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Location (opt-in family sharing) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Keeps the phone reachable for calls while the app is closed -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Huawei/EMUI & aggressive OEMs kill background services unless the app is
         exempt from battery optimization — request that so the keep-alive works. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Over-the-air self-update: install the downloaded APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- osmdroid tile cache on older Android -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- A launcher must be able to enumerate installed apps -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".AxzoraApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AxzoraOS"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="false"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.AxzoraOS">
            <!-- Normal launcher entry: AxzoraOS opens to the launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets Axzora be chosen as the phone's assistant: long-press
                 home / the assistant gesture opens its chat directly. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lets the assistant lock the screen, once the user grants it. -->
        <receiver
            android:name=".assistant.AxzoraAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Mr Happy Communication Layer: route inbound SMS through SmsGateway. -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
            Mr Happy lives inside Axzora rather than as a second app: same
            process, same install, opened by the bubble and the assistant
            gesture. Not exported - it is a face of this OS, not a launcher
            entry of its own.
        -->
        <activity
            android:name="com.axzora.happyreddy.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density" />
        <!-- OpenRoom: MiniMax's AI desktop, running on this phone in Termux.
             A first-class tile of the OS — opens full-screen, starts its own
             server if it isn't up. -->
        <activity
            android:name=".openroom.OpenRoomActivity"
            android:exported="true"
            android:label="OpenRoom"
            android:icon="@drawable/ic_openroom"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OpenRoom is now an optional app: open it from its own icon/tile,
                 but it is no longer the phone's Home. -->
        </activity>

        <!-- God's Eye View — the open-source OSINT globe, hosted in-app (not the
             external browser). Geo-enabled so it can fly to the user's location. -->
        <activity
            android:name=".godseye.GodsEyeActivity"
            android:exported="true"
            android:label="God's Eye"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
        </activity>

        <!-- Keeps the OpenRoom/backend servers alive: holds a wake-lock so the
             device doesn't idle them into suspension, and restarts them if they
             drop. Foreground (persistent notification) so it survives Doze. -->
        <service
            android:name=".openroom.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the on-device OpenRoom/backend servers alive with a wake-lock" />
        </service>
        <receiver
            android:name=".openroom.KeepAliveBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Axzora Games — the games section hub (free + Happy Paisa staked). -->
        <activity
            android:name=".games.GamesActivity"
            android:exported="true"
            android:label="Games"
            android:icon="@drawable/ic_games"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Satyug XR Room v0: A-Frame/WebXR 3D room with a voice command line. -->
        <activity
            android:name=".games.XrRoomActivity"
            android:exported="true"
            android:label="XR Room"
            android:icon="@drawable/ic_xr"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
        </activity>

        <!-- Axzora Ludo: an offline board game bundled in the app. -->
        <activity
            android:name=".games.LudoActivity"
            android:exported="true"
            android:label="Ludo"
            android:icon="@drawable/ic_ludo"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
        </activity>

        <!-- Open Sources (Colibri / p.codekk.com): the curated open-source +
             AI-tools hub, as a first-class tile of the OS. -->
        <activity
            android:name=".sources.OpenSourcesActivity"
            android:exported="true"
            android:label="Open Sources"
            android:icon="@drawable/ic_sources"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mr Happy's always-on ear: keeps the mic alive in the background
             and listens for "Mr Happy" when his screen isn't open. -->
        <service
            android:name="com.axzora.happyreddy.MrHappyService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <receiver
            android:name="com.axzora.happyreddy.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.axzora.happyreddy.RemoteActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density" />
        <service
            android:name="com.axzora.happyreddy.HappyReddyA11y"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="Mr Happy Control">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <service
            android:name=".location.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".assistant.FloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating assistant bubble the user explicitly enables" />
        </service>

        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hands the downloaded update APK to Android's installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
